import tomYJerry.*

describe "Grupo de test"{

    test "Test 1 - Velocidad maxima de tom es 10! "{
        assert.equals(10, tom.velocidadMaxima())
    }
    test "Test 2 - Al comer a Jerry la vel.Maxima es 14"{
        tom.comer(jerry)
        assert.equals(15.2, tom.velocidadMaxima())
    }
    test "Test 3 - Come a jerry y corre 24 metros, su vel.Maxima es 14"{
        tom.comer(jerry)
        tom.correr(24)
        assert.equals(14,tom.velocidadMaxima())
    }
    test "Test 4 - Tom se come a Jerry y Nibbles, su vel.Maxima es 18.7"{
        tom.comer(jerry)
        tom.correr(24)
        tom.comer(nibbles)
        assert.equals(18.7,tom.velocidadMaxima())
    }
    test "Test 5 - Tom se morfa a jerry, este cumple años y tom lo vuelve a comer,
            ademas de comer a nibbles, su vel.Maxima es 25.9"{
        tom.comer(jerry)
        tom.correr(24)
        tom.comer(nibbles)
        jerry.cumplirAnios()
        tom.comer(jerry)
        assert.equals(25.9,tom.velocidadMaxima())
        
    }
    test "Test 6 - Luego de todo, tom corre 38 metros, y su vel.Maxima pasa a ser 24"{
        tom.comer(jerry)
        tom.correr(24)
        tom.comer(nibbles)
        jerry.cumplirAnios()
        tom.comer(jerry)
        tom.correr(38)
        assert.equals(24,tom.velocidadMaxima())
    }
    
}
